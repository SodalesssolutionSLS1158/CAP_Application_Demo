{
  "name": "SiteInspection",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "express": "^4",
    "hana-cli": "^3.202504.1",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0",
    "rimraf": "^5.0.5",
    "mbt": "^1.2.29"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-employeeattachments": "cds watch --open employeeattachments/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy SiteInspection --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "private": true,
  "cds": {
    "requires": {
      "[hybrid]": {
        "auth": {
          "kind": "mocked"
        }
      },
      "db": "hana",
      "auth": {
        "kind": "xsuaa"
      },
      "[production]": {
        "auth": {
          "kind": "xsuaa"
        }
      }
    },
    "sql": {
      "native_hana_associations": false
    },
    "server": {
      "body_parser": {
        "limit": "10mb"
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/employeeattachments"
  ]
}
