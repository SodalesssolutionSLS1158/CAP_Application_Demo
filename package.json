{
  "name": "SiteInspection",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@cap-js-community/odata-v2-adapter": "^1.15.5",
    "@cap-js/change-tracking": "^1.1.3",
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "axios": "^1.13.1",
    "cds-swagger-ui-express": "^0.10.0",
    "crypto-js": "^4.2.0",
    "express": "^4",
    "hana-cli": "^3.202504.1"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9.4.3",
    "cds-plugin-ui5": "^0.13.0",
    "mbt": "^1.2.29",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "undeploy": "cf undeploy SiteInspection --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "private": true,
  "cds": {
    "requires": {
      "[hybrid]": {
        "auth": {
          "kind": "mocked"
        }
      },
      "db": "hana",
      "auth": {
        "kind": "xsuaa"
      },
      "[production]": {
        "auth": {
          "kind": "xsuaa"
        }
      }
    },
    "sql": {
      "native_hana_associations": false
    },
    "extends": "srv/server.js",
    "serverOptions": {
      "body_parser": {
        "limit": "10mb"
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/employeeattachments",
    "app/siteinspectionui"
  ]
}