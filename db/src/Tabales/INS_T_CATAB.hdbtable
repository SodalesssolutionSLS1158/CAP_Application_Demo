COLUMN TABLE "INS_T_CATAB" (
    "CAID" INTEGER NOT NULL PRIMARY KEY GENERATED ALWAYS AS IDENTITY (START WITH 1 INCREMENT BY 1 ),
    "INSID"  INTEGER,
    "CAASN"  NVARCHAR(100),
    "CASTS"  NVARCHAR(100),
    "COMDT"  DATE,
    "NOTES"  NVARCHAR(5000),
    "CREBY"  NVARCHAR(100),
    "CREDT"  DATE
);