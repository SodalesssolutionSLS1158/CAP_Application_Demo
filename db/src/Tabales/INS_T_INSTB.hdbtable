COLUMN TABLE "INS_T_INSTB"(
  "INSID" INTEGER NOT NULL PRIMARY KEY GENERATED ALWAYS AS IDENTITY (START WITH 1 INCREMENT BY 1) COMMENT 'Unique id',
  "REPBY" NVARCHAR(100),
  "FACID" NVARCHAR(10),
  "DEPID" NVARCHAR(10),
  "AREAT" NVARCHAR(100),
  "INSLD" NVARCHAR(100),
  "SHIFT" NVARCHAR(10),
  "INSDT" DATE,
  "BULCL" NVARCHAR(100),
  "SICID" NVARCHAR(10),
  "POSCT" NVARCHAR(5000),
  "TOTSA" NVARCHAR(100),
  "TOTNI" NVARCHAR(100),
  "TOTNA" NVARCHAR(100),
  "ISSAV" NVARCHAR(1)
)